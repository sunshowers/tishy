# Ghostty configuration. Run `ghostty +show-config --default --docs` for every
# option and its default, or see https://ghostty.org/docs/config.

# Lilex is installed by the image (system_files/tmp/install-fonts.sh in tishy).
font-family = Lilex

# `dankcolors` is generated by DMS's matugen templates into
# ~/.config/ghostty/themes/dankcolors, so the terminal follows the wallpaper
# palette. It appears after the first niri/DMS login; until then Ghostty
# reports the theme as missing and uses its default colors.
theme = dankcolors

# Translucent background. Under niri, the blur itself comes from a window
# rule in ~/.config/niri/config.kdl, since Ghostty doesn't request it over the
# ext-background-effect protocol.
background-opacity = 0.9
background-blur = true

# Ghostty's native quick terminal on F13. This works only where the compositor
# implements the global-shortcuts portal, i.e. under KDE. niri doesn't, so
# under niri F13 is bound in niri itself to tishy-ghostty-quake, which emulates
# a quick terminal and keeps Ghostty from seeing the key.
keybind = global:f13=toggle_quick_terminal
quick-terminal-size = 50%,60%

shell-integration-features = ssh-env
