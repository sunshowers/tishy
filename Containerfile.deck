ARG SOURCE_IMAGE=bazzite-deck

FROM ghcr.io/ublue-os/${SOURCE_IMAGE}:latest AS tishy-deck

ARG IMAGE_NAME="${IMAGE_NAME:-tishy-deck}"
ARG IMAGE_VENDOR="${IMAGE_VENDOR:-sunshowers}"

COPY system_files /

# system_files carries the build scripts in /tmp; clear them out so they don't
# ship in the image.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    /tmp/cleanup.sh && \
    ostree container commit
